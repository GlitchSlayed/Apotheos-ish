		"main": [
			"com.summit.Summit"
		],
		"client": [
			"com.summit.client.SummitClient"
		],
		"fabric-datagen": [
			"com.summit.client.SummitDataGenerator"
		]
	},
	"mixins": [
		"summit.mixins.json",
